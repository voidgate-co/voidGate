#!/usr/bin/env perl
# SPDX-License-Identifier: Apache-2.0
# Normalize Test::Base data in each file, OpenResty style:
#   - one empty line after the leading comment block;
#   - block names become "=== TEST N: name", numbered from 1;
#   - one empty line after __DATA__, three between blocks, none at EOF.
# Usage: t/bin/reindex t/*.t

use strict;
use warnings;

die "usage: $0 file.t ...\n" unless @ARGV;

for my $file (@ARGV) {
    open my $in, '<', $file or die "$file: $!\n";
    my @lines = <$in>;
    close $in;

    my (@out, $data, $n, $head);
    my $orig = join '', @lines;

    $n = 0;

    # One empty line after the leading comment block.
    $head = 0;
    $head++ while $head < @lines && $lines[$head] =~ /^#/;

    if ($head && $head < @lines) {
        splice @lines, $head, 1 while $head < @lines
                                      && $lines[$head] =~ /^\s*$/;
        splice @lines, $head, 0, "\n";
    }

    for (@lines) {
        if (!$data) {
            push @out, $_;
            $data = 1 if /^__DATA__$/;
            next;
        }

        if (/^===\s/) {
            pop @out while @out && $out[-1] =~ /^\s*$/;
            push @out, ("\n") x ($n ? 3 : 1);
            s/^===\s+(?:TEST\s+\d+:\s*)?/'=== TEST ' . ++$n . ': '/e;
        }

        push @out, $_;
    }

    pop @out while $data && @out && $out[-1] =~ /^\s*$/;
    $out[-1] .= "\n" if @out && $out[-1] !~ /\n\z/;

    next if join('', @out) eq $orig;

    open my $out, '>', $file or die "$file: $!\n";
    print {$out} @out;
    close $out;
    print "$file: $n blocks reindexed\n";
}
